# Copy to backend/.env and fill in. Never commit the real file.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
MAX_UPLOAD_MB=5
MAX_TEXT_CHARS=30000
# Use a shared store such as redis://localhost:6379 when running more than one process
RATELIMIT_STORAGE_URI=memory://
# Set to 1 in production behind exactly one trusted reverse proxy (nginx, Render, etc.)
TRUST_PROXY=0
